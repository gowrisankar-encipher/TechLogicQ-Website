# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the site, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://techlogicq.vercel.app

# ---- Admin login (/admin) ----
# The admin email and password are stored in MongoDB, not here. Create them with:  npm run create-admin
# Random string of at least 32 characters, used to sign the admin login cookie. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Contact form email (Gmail SMTP) ----
SMTP_USER=gowrisankarv.work@gmail.com
# Google App Password (16 characters, from https://myaccount.google.com/apppasswords)
SMTP_PASS=
# Where contact form messages are delivered (defaults to SMTP_USER).
CONTACT_TO_EMAIL=gowrisankarv.work@gmail.com

# ---- MongoDB (admin account + job openings) ----
# Your MongoDB Atlas connection string. Required for the admin panel.
# Without it, the Careers page falls back to data/jobs.json (read-only use).
MONGODB_URI=
MONGODB_DB=techlogicq
